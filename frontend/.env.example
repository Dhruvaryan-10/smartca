# frontend/.env.example
#
# Phase 1B status: PostgreSQL + Drizzle is the database foundation (see
# docs/decisions/0001-postgres-over-mongodb.md), and Auth.js now provides
# email/password authentication with a user-scoped service layer on top
# (see MIGRATION-CHECKPOINT.md). The frontend is reconnected to the
# database through this auth + service layer — the old, unauthenticated
# Mongoose /api/transactions route was removed in Phase 0 and is not
# coming back.
#
# Copy to frontend/.env.local and fill in real values. Never commit
# frontend/.env.local.

# PostgreSQL connection string for the `smartca` database, e.g.:
#   postgresql://<user>:<password>@localhost:5432/smartca
# Required by Drizzle (db/client.ts, drizzle.config.ts), the
# db:generate/db:migrate/db:seed/db:verify scripts, and every service in
# frontend/services/.
DATABASE_URL=

# Auth.js session-signing secret. Required — there is no insecure
# fallback; frontend/auth.ts throws a clear error at startup if this is
# unset. Generate one with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=
