# frontend/.env.example
#
# Phase 1B status: PostgreSQL + Drizzle is the database foundation (see
# docs/decisions/0001-postgres-over-mongodb.md), and Auth.js now provides
# email/password authentication with a user-scoped service layer on top
# (see MIGRATION-CHECKPOINT.md). The frontend is reconnected to the
# database through this auth + service layer — the old, unauthenticated
# Mongoose /api/transactions route was removed in Phase 0 and is not
# coming back.
#
# Copy to frontend/.env.local and fill in real values. Never commit
# frontend/.env.local.

# PostgreSQL connection string for the `smartca` database, e.g.:
#   postgresql://<user>:<password>@localhost:5432/smartca
# Required by Drizzle (db/client.ts, drizzle.config.ts), the
# db:generate/db:migrate/db:seed/db:verify scripts, and every service in
# frontend/services/.
DATABASE_URL=

# Auth.js session-signing secret. Required — there is no insecure
# fallback; frontend/auth.ts throws a clear error at startup if this is
# unset. Generate one with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=

# --- Assistant (Phase 6K): server-only. Off by default. Nothing here is ever exposed to the browser. ---
# ASSISTANT_ENV: only "synthetic" is valid today. Any other value, a real-data mode included,
# is refused (the assistant fails closed). The synthetic transport never contacts MODEL_ENDPOINT and
# never uses MODEL_API_KEY: leave the key empty or a placeholder. NEVER put a real key here or in
# any committed file. The eight variables from ASSISTANT_ENABLED to MODEL_MAX_OUTPUT_CHARS are required when ASSISTANT_ENABLED=true;
# the ones after them are required only by an EXTERNAL configuration (which the reader still refuses: docs/decisions/0002 and 0004).
# `npm run assistant:preflight` checks a complete external configuration and the database WITHOUT enabling it, and prints names only.
ASSISTANT_ENABLED=false
ASSISTANT_ENV=synthetic
MODEL_ENDPOINT=
MODEL_API_KEY=
MODEL_ID=
MODEL_APPROVED_RECIPIENTS=
MODEL_TIMEOUT_MS=
MODEL_MAX_OUTPUT_CHARS=
# The most output tokens the provider may generate per model call (1 to 50000), required only by an EXTERNAL configuration.
# It bounds generation cost per call and is sent on every provider request; no request or model answer can change it. The
# MODEL_MAX_OUTPUT_CHARS answer cap still applies on top of it. No default: an external configuration without it fails closed.
MODEL_MAX_OUTPUT_TOKENS=
# The wire format the external endpoint speaks, required only by an EXTERNAL configuration, one of:
#   openai-chat-completions             OpenAI-compatible Chat Completions; the cap is sent as the current output-token field
#   openai-chat-completions-max-tokens  the same format, for compatible servers/gateways that still need the older output-token field
# No default: an external configuration without a listed value fails closed (docs/decisions/0004).
MODEL_WIRE_FORMAT=
# Limits, required only by an EXTERNAL configuration (which the reader still refuses): the window, the runs one person may
# start in it, the runs they may have in progress at once, the model tokens they may use in it, and the runs in progress
# across everyone at once (at least the per-person value). No default: an external configuration without every one of
# them fails closed. They are deployment decisions (docs/decisions/0003), sized to the chosen provider's quota and cost.
ASSISTANT_RATE_WINDOW_SECONDS=
ASSISTANT_MAX_RUNS_PER_WINDOW=
ASSISTANT_MAX_CONCURRENT_RUNS=
ASSISTANT_MAX_TOKENS_PER_WINDOW=
ASSISTANT_MAX_GLOBAL_CONCURRENT_RUNS=
# Days the assistant run audit (metadata only) is kept, 1 to 3650. Required by an external configuration and by the
# scheduled `npm run assistant:purge-runs` job, which deletes older run rows (never consent records).
ASSISTANT_RUN_RETENTION_DAYS=
