# frontend/.env.example
#
# Phase 1A status: PostgreSQL + Drizzle is the new database foundation
# (see docs/decisions/0001-postgres-over-mongodb.md). The MongoDB-backed
# /api/transactions route (Mongoose) was already removed in Phase 0.
#
# Copy to frontend/.env.local and fill in a real value. Never commit
# frontend/.env.local.

# PostgreSQL connection string for the `smartca` database, e.g.:
#   postgresql://<user>:<password>@localhost:5432/smartca
# Required by Drizzle (db/client.ts, drizzle.config.ts) and the
# db:generate/db:migrate/db:seed/db:verify scripts. Not yet consumed by
# any frontend page — the application is not reconnected to the
# database until a later phase (see MIGRATION-CHECKPOINT.md).
DATABASE_URL=
