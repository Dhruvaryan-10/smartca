# backend/.env.example
#
# LEGACY Flask backend (Phase 0 status).
# The MongoDB Atlas cluster this service depended on has been permanently
# deleted. This service cannot start without the variables below, and is
# pending full replacement by the PostgreSQL/Drizzle service layer planned
# for Phase 1. See docs/SMARTCA-REPOSITORY-AUDIT.md and
# MIGRATION-CHECKPOINT.md for details.
#
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# JWT signing secret. Required — there is no insecure fallback default
# anymore (one was removed in Phase 0; see audit finding #3).
SECRET_KEY=

# MongoDB connection string. Required by this legacy code path only.
# The cluster it previously pointed to has been permanently deleted — do
# not reuse the old credential (see audit finding #1). This variable, and
# the code that reads it, will be removed entirely when the Flask backend
# is retired in Phase 1.
MONGO_URI=
